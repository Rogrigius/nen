# Токен бота с Discord Developer Portal (раздел Bot -> Reset Token).
# Скопируйте этот файл в .env и вставьте свой токен.
DISCORD_TOKEN=

# Пауза после подключения к голосовому каналу перед проигрыванием звука,
# в миллисекундах. Необязательно; по умолчанию 4000 (4 секунды).
# Например, 1500 — полторы секунды.
JOIN_DELAY_MS=4000
